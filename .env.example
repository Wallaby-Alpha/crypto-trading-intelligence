# ==============================================================================
# WEEX CRYPTO TRADING BOT ENVIRONMENT CONFIGURATION
# ==============================================================================

# 1. EXCHANGE CREDENTIALS (WEEX API)
# Generate your API Key, Secret, and Passphrase from your WEEX account settings
WEEX_API_KEY=your_weex_api_key_here
WEEX_SECRET=your_weex_api_secret_here
WEEX_PASSPHRASE=your_weex_passphrase_here

# 2. MASTER SAFETY SWITCH
# Set to 'true' to execute real-money orders on WEEX.
# When 'false', runs in safe dry-run / paper mode against live exchange orderbooks.
ENABLE_LIVE_TRADING=true

# 3. DE MINIMIS RISK GOVERNANCE
# Margin allocated per trade in USD (Recommended to start: $10 - $25)
TRADE_AMOUNT_USD=15.0

# Isolated Margin Leverage (Conservative default: 2x or 3x)
DEFAULT_LEVERAGE=2

# Maximum concurrent open positions across the entire universe
# Prevents correlated crypto-wide portfolio drawdowns
MAX_CONCURRENT_POSITIONS=2

# Daily loss circuit breaker in USD
# If cumulative daily realized loss hits this limit, all new trade entries halt for 24h
MAX_DAILY_LOSS_USD=30.0

# 4. TELEGRAM NOTIFICATIONS & REMOTE ALERTS
# Create a bot via @BotFather and get your personal or channel chat ID via @userinfobot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# 5. POLLING FREQUENCY
# Seconds between scanner cycles
POLL_INTERVAL_SECONDS=20
